---
/**
 * Tool cards with an icon, an outcome-first headline and a benefit chip.
 * `grouped` (tools index) splits by category; otherwise a flat grid (homepage).
 */
import ToolIcon from '~/components/ToolIcon.astro';
import { tools, toolCategories, type Tool, type ToolCategory } from '~/data/site';
import { url } from '~/lib/url';

export interface Props {
  grouped?: boolean;
  exclude?: string[];
}
const { grouped = false, exclude = [] } = Astro.props;

/** What the student gets, in their words — leads the card. */
const pitch: Record<string, { hook: string; chip: string }> = {
  'dark-to-light': { hook: 'Black notes → white A4', chip: 'Up to 60% less ink' },
  'pages-per-sheet': { hook: '4 slides on one page', chip: 'Up to 89% less paper' },
  'grayscale-pdf': { hook: 'Print with black ink only', chip: 'Colour ink untouched' },
  merge: { hook: 'All chapters, one PDF', chip: 'Drag to reorder' },
  'split-pdf': { hook: 'One big PDF → chapters', chip: 'By range or every N pages' },
  'extract-pages': { hook: 'Keep only the pages you need', chip: 'Perfect for formula sheets' },
  'organize-pdf': { hook: 'Reorder & delete pages', chip: 'Visual thumbnails' },
  'rotate-pdf': { hook: 'Fix sideways pages', chip: 'Saved permanently' },
  'crop-pdf': { hook: 'Trim margins, print bigger', chip: 'Bigger, clearer text' },
  'add-page-numbers': { hook: 'Number every page', chip: 'Printouts stay in order' },
  compress: { hook: 'Small enough for WhatsApp', chip: 'Send big PDFs easily' },
  'pdf-to-jpg': { hook: 'PDF pages → images', chip: 'JPG or PNG' },
  'image-to-pdf': { hook: 'Photos of notes → one PDF', chip: 'Straight from your camera' },
};

const hue: Record<ToolCategory, string> = {
  print: '#EA580C',
  organize: '#2563EB',
  convert: '#9333EA',
  optimize: '#16A34A',
};

const list = tools.filter((t) => !exclude.includes(t.slug));
const groups: [ToolCategory, Tool[]][] = grouped
  ? (Object.keys(toolCategories) as ToolCategory[]).map((c) => [c, list.filter((t) => t.category === c)] as [ToolCategory, Tool[]]).filter(([, ts]) => ts.length)
  : [['print', list]];
---

{groups.map(([cat, ts]) => (
  <div class="tg-group">
    {grouped && (
      <h2 class="tg-group__title" style={`--hue:${hue[cat]}`}>
        <i aria-hidden="true"></i>{toolCategories[cat]}<span>{ts.length} tools</span>
      </h2>
    )}
    <ul class="tg" role="list">
      {ts.map((t) => {
        const p = pitch[t.slug] ?? { hook: t.name, chip: '' };
        return (
          <li>
            <a href={url(`/tools/${t.slug}/`)} class="tc" style={`--hue:${hue[t.category]}`}>
              <span class="tc__top">
                <span class="tc__icon" aria-hidden="true"><ToolIcon name={t.slug} size={26} /></span>
                <span class="tc__name">{t.shortName}</span>
              </span>
              <span class="tc__hook">{p.hook}</span>
              <span class="tc__desc">{t.description}</span>
              <span class="tc__foot">
                {p.chip && <span class="tc__chip">{p.chip}</span>}
                <span class="tc__go" aria-hidden="true">
                  Open
                  <svg viewBox="0 0 24 24" width="16" height="16"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"/></svg>
                </span>
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
))}

<style>
  .tg-group + .tg-group { margin-top: var(--space-8); }
  .tg-group__title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-4);
  }
  .tg-group__title i { width: 10px; height: 10px; border-radius: 3px; background: var(--hue); }
  .tg-group__title span { font-size: 0.8125rem; font-weight: 600; color: var(--fg-subtle); }

  .tg {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-4);
  }
  .tc {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-5);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(120% 80% at 100% 0%, color-mix(in srgb, var(--hue) 9%, transparent), transparent 60%),
      var(--bg-elev);
    border: 1px solid var(--border);
    color: inherit;
    overflow: hidden;
    transition: transform 220ms var(--ease-out), box-shadow 220ms var(--ease-out), border-color 220ms var(--ease-out);
  }
  .tc:hover {
    text-decoration: none;
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--hue) 55%, var(--border));
    box-shadow: 0 18px 40px -18px color-mix(in srgb, var(--hue) 55%, transparent), var(--shadow);
  }
  .tc:focus-visible { outline: 3px solid var(--hue); outline-offset: 3px; }

  .tc__top { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
  .tc__icon {
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border-radius: 16px;
    color: var(--hue);
    background: color-mix(in srgb, var(--hue) 13%, transparent);
    border: 1px solid color-mix(in srgb, var(--hue) 22%, transparent);
    transition: transform 260ms var(--ease-out), background 220ms;
  }
  .tc:hover .tc__icon { transform: rotate(-6deg) scale(1.08); background: color-mix(in srgb, var(--hue) 20%, transparent); }
  .tc__name {
    font: 700 0.75rem var(--font-ui);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--hue);
  }
  .tc__hook {
    margin-top: var(--space-5);
    font: 800 1.25rem/1.25 var(--font-ui);
    letter-spacing: -0.02em;
    color: var(--fg);
  }
  .tc__desc {
    margin-top: var(--space-2);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--fg-muted);
  }
  .tc__foot {
    margin-top: auto;
    padding-top: var(--space-5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .tc__chip {
    font: 700 0.75rem var(--font-ui);
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    color: var(--fg);
    background: var(--bg-soft);
    border: 1px solid var(--border);
  }
  .tc__go {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
    font: 800 0.875rem var(--font-ui);
    color: var(--hue);
  }
  .tc__go svg { transition: transform 200ms var(--ease-out); }
  .tc:hover .tc__go svg { transform: translateX(4px); }

  @media (prefers-reduced-motion: reduce) {
    .tc, .tc__icon, .tc__go svg { transition: none; }
    .tc:hover, .tc:hover .tc__icon, .tc:hover .tc__go svg { transform: none; }
  }
</style>
