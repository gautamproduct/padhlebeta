---
import { url } from '~/lib/url';
import { ncertClasses, subjectMeta, ncertPath, totalChapters, SESSION } from '~/data/ncert';
---

<section class="section home-ncert" aria-labelledby="home-ncert-h">
  <div class="container">
    <div class="hn">
      <div class="hn__copy">
        <span class="eyebrow">New · NCERT {SESSION}</span>
        <h2 id="home-ncert-h">NCERT books PDF, <span class="hl">every chapter free.</span></h2>
        <p>
          All {totalChapters} chapters of the Class 9, 10, 11 and 12 NCERT textbooks. Read online in a fast reader or
          download — chapter-wise or the full book as one PDF. No login.
        </p>
        <a href={url(ncertPath.hub())} class="btn btn--primary btn--lg">Browse NCERT PDFs</a>
      </div>
      <ul class="hn__grid" role="list">
        {[...ncertClasses].reverse().map((c) => (
          <li>
            <a href={url(ncertPath.cls(c.cls))} class="hn__cls">
              <b>Class {c.cls}</b>
              <span>{c.subjects.reduce((a, s) => a + s.chapters.length, 0)} chapters</span>
            </a>
            <span class="hn__subs">
              {c.subjects.map((s) => (
                <a href={url(ncertPath.subject(c.cls, s.slug))} style={`--hue:${subjectMeta[s.slug]?.hue ?? '#64748B'}`}>{s.name}</a>
              ))}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .hn { display: grid; grid-template-columns: 1fr 1.15fr; gap: var(--space-8); align-items: center; }
  @media (max-width: 900px) { .hn { grid-template-columns: 1fr; } }
  .hn__copy h2 { font-size: var(--text-3xl); line-height: 1.1; letter-spacing: -0.03em; }
  .hl { color: var(--accent); }
  .hn__copy p { color: var(--fg-muted); font-size: 1.0625rem; margin: var(--space-4) 0 var(--space-6); line-height: 1.6; }
  .hn__grid { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-3); }
  .hn__grid li {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .hn__cls { flex: none; width: 104px; display: flex; flex-direction: column; color: inherit; }
  .hn__cls:hover { text-decoration: none; color: var(--accent); }
  .hn__cls b { font-size: 1.125rem; }
  .hn__cls span { font-size: 0.8125rem; color: var(--fg-subtle); }
  .hn__subs { display: flex; flex-wrap: wrap; gap: 6px; }
  .hn__subs a {
    font: 700 0.8125rem var(--font-ui);
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    color: var(--hue);
    background: color-mix(in srgb, var(--hue) 10%, transparent);
  }
  .hn__subs a:hover { text-decoration: none; background: color-mix(in srgb, var(--hue) 18%, transparent); }
  @media (max-width: 480px) {
    .hn__grid li { flex-direction: column; align-items: flex-start; gap: var(--space-2); }
  }
</style>
